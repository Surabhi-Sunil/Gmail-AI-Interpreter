GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SERVER_ROOT_URL=http://localhost:4001
CLIENT_ROOT_URL=http://localhost:5173
SESSION_SECRET=super-secret-session-key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GMAIL_QUERY=in:inbox is:unread -category:promotions newer_than:90d
GMAIL_SYNC_LIMIT=20
GMAIL_SYNC_CONCURRENCY=8
TASK_EXTRACTION_CHUNK_SIZE=3
MAX_EMAIL_BODY_CHARS=1200
OLLAMA_MAX_TOKENS=4096
OLLAMA_AGENT_RETRIES=2
OLLAMA_REQUEST_TIMEOUT_MS=120000
